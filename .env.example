# ── Discord Application ───────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Application (client) ID from the Developer Portal
CLIENT_ID=

# Guild ID for instant slash command deployment during development.
# Comment out or remove for global deployment (takes up to 1 hour to propagate).
DEPLOY_GUILD_ID=

# Your personal Discord user ID — grants OWNER permission level to all commands.
BOT_OWNER_ID=

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:password@localhost:5432/discordbot?schema=public

# ── Cache ─────────────────────────────────────────────────────────────────────
# Redis connection string.
# Format: redis://:PASSWORD@HOST:PORT  (omit :PASSWORD@ if no auth)
REDIS_URL=redis://localhost:6379

# ── Runtime ───────────────────────────────────────────────────────────────────
# Set to "production" on the live server. Production hides debug logs.
NODE_ENV=development

# Set to 1 to log every Prisma query (very verbose; for debugging only).
# Default: Prisma logs warnings and errors only.
# PRISMA_LOG_QUERIES=1

# ── Container / homelab ───────────────────────────────────────────────────────
# Optional. Left commented out on purpose: an empty value in a Docker env file
# would override the value the image sets. Uncomment only to change a default.

# Port for the health endpoints: GET /healthz (process alive) and GET /readyz
# (every shard connected to Discord). Defaults to 8081.
# HEALTH_PORT=8081

# Directory for state that must survive restarts (the restart-brake history).
# Defaults to ./state. The Docker image sets /app/state (mount a named volume).
# STATE_DIR=./state

# File that stores the slash-command hash used by auto-deploy.
# Defaults to ./.deploy-hash. The Docker image sets /app/state/.deploy-hash.
# DEPLOY_HASH_FILE=./.deploy-hash

# ── Translation backend ───────────────────────────────────────────────────────
# google (default): free translate.googleapis.com endpoint, no key, rate-limits hard
# libretranslate:   self-hosted LibreTranslate server (no key needed unless it has API keys on)
# Any other value logs a warning and uses google.
# TRANSLATE_PROVIDER=libretranslate
# LIBRETRANSLATE_URL=http://localhost:5000
# LIBRETRANSLATE_API_KEY=

# ── Outbound HTTP: feeds and search commands ──────────────────────────────────
# Optional. No built-in feature needs an API key.
# Contact (email or URL) added to the User-Agent of every outbound request
# (RSS/YouTube/Reddit/Bluesky/podcast feeds, /anime, /manga, /pokemon, /urban),
# as PokeAPI and Reddit etiquette ask. Default: "n/a".
# HTTP_CONTACT=you@example.com

# User-Agent for Reddit feeds (reddit.com/r/<subreddit>/new/.rss). Reddit
# throttles generic agents: describe the bot and include your Reddit username.
# Default: the bot's standard User-Agent (which includes HTTP_CONTACT).
# REDDIT_USER_AGENT=discord-bot/1.0 (by /u/yourname)

# Base URL of the Bluesky AppView used by Bluesky feeds (public, no key).
# Default: https://public.api.bsky.app
# BSKY_APPVIEW_URL=https://public.api.bsky.app

# ── Web dashboard ─────────────────────────────────────────────────────────────
# Optional: only `npm run dashboard` (dashboard.js, a separate process) reads
# these; the bot ignores them. Admins log in with Discord and switch modules
# on or off per server. The dashboard also uses CLIENT_ID, DISCORD_TOKEN,
# DATABASE_URL, REDIS_URL and BOT_OWNER_ID from above (the bot owner may
# manage every server the bot is in). Without the two secrets
# it does not start: /healthz stays 200 and every page names the missing keys.

# OAuth2 client secret: Developer Portal → your application → OAuth2 → Client
# Secret. Also add the redirect URI ${DASHBOARD_URL}/auth/callback (for example
# http://localhost:8080/auth/callback) under OAuth2 → Redirects.
# DISCORD_CLIENT_SECRET=

# Encrypts the login cookie. At least 32 characters; changing it logs everyone
# out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DASHBOARD_SESSION_SECRET=

# Public base URL of the dashboard as users open it (no path). An https URL
# also makes the login cookie Secure. Default: http://localhost:8080
# DASHBOARD_URL=https://dashboard.example.com

# Port and interface the dashboard listens on. Defaults: 8080 and 0.0.0.0.
# DASHBOARD_PORT=8080
# DASHBOARD_HOST=0.0.0.0

# ── Development ───────────────────────────────────────────────────────────────
# Guild id that `npm run db:seed` creates a GuildSettings row for.
# Default: 000000000000000000
# TEST_GUILD_ID=000000000000000000

# Connection string of a throw-away Postgres database for the opt-in database
# tests (test/db.test.js). Only the test runner reads it; never point it at real data.
# TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/discordbot_test?schema=public
