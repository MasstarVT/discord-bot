# Keep assets/ (the canvas font) and prisma/ (schema + migrations) in the context.
node_modules
.env
.env.*
logs
.deploy-hash
state
.git
.github
.claude
*.log
# Local tooling and audit output (git-ignored, large): never part of the image.
graphify-out
.audit-checkpoint
claude-code-hooks
claude-token-saver
# Rust build output and the local mock database (tens of GB): never part of the context.
rust/target
rust/target-seed
rust/target-agents
rust/mockdb
rust/fixtures
rust/docs
