{
  "name": "discord-bot",
  "version": "1.0.0",
  "description": "Production-grade multi-purpose Discord bot",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "deploy": "node index.js --deploy",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "node src/database/seed.js",
    "pm2:start": "pm2 start pm2.config.cjs --env production",
    "pm2:reload": "pm2 reload discord-bot",
    "pm2:logs": "pm2 logs discord-bot"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.56",
    "@prisma/client": "^5.22.0",
    "chalk": "^5.3.0",
    "discord.js": "^14.16.0",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "prisma": "5.22.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "pm2": "^5.4.3"
  }
}
